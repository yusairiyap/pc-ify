<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcIfy.Client.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="PcIfy.Client.Views.Browser.ImagePickerPage"
             x:DataType="vm:ImagePickerViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⬆" Command="{Binding NavigateUpCommand}" Order="Primary"/>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" Order="Primary"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- Hint bar -->
        <Label Grid.Row="0"
               Text="Tap an image to set it as this folder's background"
               FontSize="12" HorizontalTextAlignment="Center"
               Padding="12,8"
               TextColor="{AppThemeBinding Light='#666', Dark='#999'}"
               BackgroundColor="{AppThemeBinding Light='#F0F0F0', Dark='#1A1A1A'}"/>

        <!-- Spinner -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{DynamicResource Primary}"
                           VerticalOptions="Center" HorizontalOptions="Center"/>

        <!-- Grid of folders + images -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        IsVisible="{Binding IsNotBusy}"
                        SelectionMode="None"
                        Margin="8">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3"
                                 HorizontalItemSpacing="6" VerticalItemSpacing="6"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BrowserItemViewModel">
                    <Border StrokeThickness="1.5"
                            Stroke="{AppThemeBinding Light='#E0E0E0', Dark='#2A2A2A'}"
                            BackgroundColor="{AppThemeBinding Light='White', Dark='#1E1E1E'}"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <!-- Image items get a primary-colour border to hint they're selectable -->
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsImage}"
                                         Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource Primary}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="100,32">
                            <Border Grid.Row="0"
                                    BackgroundColor="{AppThemeBinding Light='#F0F0F0', Dark='#252525'}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10,10,0,0"/></Border.StrokeShape>
                                <Grid>
                                    <Image IsVisible="{Binding HasThumbnail}" Aspect="AspectFill">
                                        <Image.Source>
                                            <UriImageSource Uri="{Binding ThumbnailUri}"
                                                            CachingEnabled="True"
                                                            CacheValidity="0.01:00:00"/>
                                        </Image.Source>
                                    </Image>
                                    <Label IsVisible="{Binding HasThumbnail, Converter={StaticResource InvertBoolConverter}}"
                                           Text="{Binding Entry.Type, Converter={StaticResource FileTypeToIconConverter}}"
                                           FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                            <Label Grid.Row="1" Text="{Binding Entry.Name}"
                                   FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"
                                   Padding="6,0" HorizontalTextAlignment="Center" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light='#222', Dark='#DDD'}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
