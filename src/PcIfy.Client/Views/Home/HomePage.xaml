<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcIfy.Client.ViewModels"
             xmlns:models="clr-namespace:PcIfy.Client.Models"
             x:Class="PcIfy.Client.Views.Home.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="pc-ify">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,16"
              BackgroundColor="{AppThemeBinding Light='White', Dark='#1A1A1A'}">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="pc-ify" FontSize="22" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light='#111', Dark='White'}"/>
                <Label Text="Your media, anywhere on your network"
                       FontSize="12" TextColor="{AppThemeBinding Light='#666', Dark='#999'}"/>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Browse All"
                    Command="{Binding BrowseAllCommand}"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White" CornerRadius="8"
                    FontSize="13" Padding="12,8"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- Empty state -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding HasNoBookmarks}"
                                     HorizontalOptions="Center" Margin="0,60,0,0">
                    <Label Text="📁" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="No bookmarks yet"
                           FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light='#333', Dark='#DDD'}"/>
                    <Label Text="Browse your files and bookmark your favourite folders"
                           FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light='#666', Dark='#999'}"/>
                </VerticalStackLayout>

                <!-- Bookmarks section -->
                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding HasNoBookmarks, Converter={StaticResource InvertBoolConverter}}">
                    <Label Text="Bookmarks" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light='#333', Dark='#DDD'}" Margin="4,0"/>
                    <CollectionView ItemsSource="{Binding BookmarkedFolders}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2"
                                             HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BookmarkedFolder">
                                <Border Stroke="{AppThemeBinding Light='#E0E0E0', Dark='#2E2E2E'}"
                                        StrokeThickness="1" Padding="16"
                                        BackgroundColor="{AppThemeBinding Light='White', Dark='#1E1E1E'}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenFolderCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="📁" FontSize="28" HorizontalOptions="Center"/>
                                        <Label Text="{Binding DisplayName}" FontSize="13" FontAttributes="Bold"
                                               HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="2"
                                               TextColor="{AppThemeBinding Light='#222', Dark='#EEE'}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
