<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcIfy.Client.ViewModels"
             x:Class="PcIfy.Client.Views.Setup.SetupPage"
             x:DataType="vm:SetupViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#111111" Offset="0"/>
            <GradientStop Color="#0A0A0A" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="32,60,32,32" MaximumWidthRequest="480" HorizontalOptions="Center">

            <!-- Logo / Title -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="pc-ify"
                       FontSize="48" FontAttributes="Bold"
                       TextColor="{DynamicResource Primary}" HorizontalOptions="Center"/>
                <Label Text="Your personal media server"
                       FontSize="14" TextColor="#AAAAAA" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Server card -->
            <Border Stroke="#333333" StrokeThickness="1" Padding="24"
                    BackgroundColor="#1E1E1E">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">

                    <Label Text="Server Address" FontAttributes="Bold" TextColor="#DDDDDD" FontSize="13"/>

                    <Grid ColumnDefinitions="*,Auto,80" ColumnSpacing="8">
                        <Entry Grid.Column="0" Placeholder="192.168.1.100"
                               Text="{Binding Host}"
                               Keyboard="Url" TextColor="White"
                               PlaceholderColor="#666666"
                               BackgroundColor="#2A2A2A"/>
                        <Label Grid.Column="1" Text=":" TextColor="#AAAAAA"
                               VerticalOptions="Center" FontSize="18"/>
                        <Entry Grid.Column="2" Placeholder="8080"
                               Text="{Binding Port}"
                               Keyboard="Numeric" TextColor="White"
                               PlaceholderColor="#666666"
                               BackgroundColor="#2A2A2A"/>
                    </Grid>

                    <Button Text="Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            CornerRadius="10"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{DynamicResource Primary}"
                                       IsVisible="{Binding IsBusy}"/>

                    <Label Text="{Binding StatusMessage}"
                           TextColor="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#66FF99|#FF6666'}"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullConverter}}"
                           HorizontalOptions="Center" FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <!-- Login card (shown after ping succeeds) -->
            <Border Stroke="#333333" StrokeThickness="1" Padding="24"
                    BackgroundColor="#1E1E1E"
                    IsVisible="{Binding ShowLoginSection}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">

                    <Label Text="Sign In" FontAttributes="Bold" TextColor="#DDDDDD" FontSize="13"/>

                    <Entry Placeholder="Username" Text="{Binding Username}"
                           TextColor="White" PlaceholderColor="#666666"
                           BackgroundColor="#2A2A2A"/>

                    <Entry Placeholder="Password" Text="{Binding Password}"
                           IsPassword="True" TextColor="White"
                           PlaceholderColor="#666666" BackgroundColor="#2A2A2A"/>

                    <Button Text="Login"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            CornerRadius="10"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
