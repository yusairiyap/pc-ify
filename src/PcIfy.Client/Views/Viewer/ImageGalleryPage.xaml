<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcIfy.Client.ViewModels"
             xmlns:dto="clr-namespace:PcIfy.Shared.DTOs.Files;assembly=PcIfy.Shared"
             x:Class="PcIfy.Client.Views.Viewer.ImageGalleryPage"
             x:DataType="vm:ImageGalleryViewModel"
             Title="{Binding Title}"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">

        <CarouselView
            Grid.Row="0"
            ItemsSource="{Binding Images}"
            Position="{Binding CurrentIndex, Mode=TwoWay}"
            Loop="False">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="dto:FileEntryDto">
                    <Grid>
                        <Image Aspect="AspectFit" BackgroundColor="Black">
                            <Image.Source>
                                <UriImageSource
                                    Uri="{Binding Path, Converter={StaticResource PathToStreamUriConverter}}"
                                    CachingEnabled="True"
                                    CacheValidity="1.00:00:00"/>
                            </Image.Source>
                        </Image>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Bottom bar: filename + navigation -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Padding="12,8"
              BackgroundColor="#CC000000">
            <Button Grid.Column="0" Text="‹" FontSize="22" TextColor="White"
                    BackgroundColor="Transparent" Padding="8,4"
                    Command="{Binding GoPreviousCommand}"/>
            <Label Grid.Column="1"
                   Text="{Binding CurrentImageName}"
                   TextColor="#CCCCCC" FontSize="13" MaxLines="1"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center" HorizontalOptions="Center"/>
            <Button Grid.Column="2" Text="›" FontSize="22" TextColor="White"
                    BackgroundColor="Transparent" Padding="8,4"
                    Command="{Binding GoNextCommand}"/>
        </Grid>

    </Grid>

</ContentPage>
