<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcIfy.Client.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="PcIfy.Client.Views.Viewer.VideoPlayerPage"
             x:DataType="vm:VideoPlayerViewModel"
             Title="{Binding Title}"
             BackgroundColor="Black">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="External Player" Command="{Binding OpenExternalCommand}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">

        <toolkit:MediaElement
            Grid.Row="0"
            Source="{Binding StreamUri}"
            ShouldAutoPlay="True"
            ShouldShowPlaybackControls="True"
            Aspect="AspectFit"
            BackgroundColor="Black"/>

        <Label Grid.Row="1"
               Text="{Binding FileName}"
               FontSize="14" TextColor="#CCCCCC"
               Padding="16,8"
               BackgroundColor="#1A1A1A"
               MaxLines="1" LineBreakMode="TailTruncation"/>

    </Grid>

</ContentPage>
