<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PcIfy.Client.ViewModels"
             x:Class="PcIfy.Client.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,8">

            <!-- Appearance section -->
            <Label Text="APPEARANCE" FontSize="11" FontAttributes="Bold"
                   Margin="20,16,20,6" TextColor="{DynamicResource Primary}"/>

            <Border Margin="16,0" Padding="0"
                    BackgroundColor="{AppThemeBinding Light='White', Dark='#1E1E1E'}"
                    Stroke="{AppThemeBinding Light='#E0E0E0', Dark='#2A2A2A'}" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                <VerticalStackLayout>

                    <!-- Theme toggle -->
                    <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Color Theme" FontSize="15"
                                   TextColor="{AppThemeBinding Light='#222', Dark='#EEE'}"/>
                            <Label Text="Choose light, dark, or follow system"
                                   FontSize="12" TextColor="{AppThemeBinding Light='#888', Dark='#888'}"/>
                        </VerticalStackLayout>
                        <Picker Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                SelectedItem="{Binding SelectedTheme}"
                                WidthRequest="100"
                                TextColor="{AppThemeBinding Light='#222', Dark='#EEE'}"
                                BackgroundColor="Transparent"/>
                    </Grid>

                    <!-- Separator: Style="{x:Null}" prevents the global BoxView style overriding our color -->
                    <BoxView Style="{x:Null}" HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light='#EEEEEE', Dark='#2A2A2A'}"
                             Margin="16,0"/>

                    <!-- Accent color picker -->
                    <VerticalStackLayout Padding="16,14" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Accent Color" FontSize="15"
                                       TextColor="{AppThemeBinding Light='#222', Dark='#EEE'}"/>
                                <Label Text="Tap a color to select"
                                       FontSize="12" TextColor="{AppThemeBinding Light='#888', Dark='#888'}"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{Binding AccentColor}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                            </Border>
                        </Grid>
                        <!-- Color swatches -->
                        <CollectionView ItemsSource="{Binding PresetColors}"
                                        SelectionMode="None" HeightRequest="52">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                            BackgroundColor="{Binding ., Converter={StaticResource StringToColorConverter}}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SelectAccentColorCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <BoxView Style="{x:Null}" HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light='#EEEEEE', Dark='#2A2A2A'}"
                             Margin="16,0"/>

                    <!-- Grid density -->
                    <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Grid Density" FontSize="15"
                                   TextColor="{AppThemeBinding Light='#222', Dark='#EEE'}"/>
                            <Label Text="Number of items per row"
                                   FontSize="12" TextColor="{AppThemeBinding Light='#888', Dark='#888'}"/>
                        </VerticalStackLayout>
                        <Picker Grid.Column="1" ItemsSource="{Binding DensityOptions}"
                                SelectedItem="{Binding GridDensity}"
                                WidthRequest="100"
                                TextColor="{AppThemeBinding Light='#222', Dark='#EEE'}"
                                BackgroundColor="Transparent"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button Text="Apply Appearance"
                    Command="{Binding ApplyThemeCommand}"
                    Margin="16,12" BackgroundColor="{DynamicResource Primary}"
                    TextColor="White" CornerRadius="10"/>

            <!-- Connection section -->
            <Label Text="CONNECTION" FontSize="11" FontAttributes="Bold"
                   Margin="20,16,20,6" TextColor="{DynamicResource Primary}"/>

            <Border Margin="16,0" Padding="0"
                    BackgroundColor="{AppThemeBinding Light='White', Dark='#1E1E1E'}"
                    Stroke="{AppThemeBinding Light='#E0E0E0', Dark='#2A2A2A'}" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Server" FontSize="15"
                               TextColor="{AppThemeBinding Light='#222', Dark='#EEE'}"/>
                        <Label Text="{Binding ServerAddress}" FontSize="12"
                               TextColor="{AppThemeBinding Light='#888', Dark='#888'}"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Change"
                            Command="{Binding ChangeServerCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Primary}"
                            FontSize="13" Padding="8,0"/>
                </Grid>
            </Border>

            <!-- Account section -->
            <Label Text="ACCOUNT" FontSize="11" FontAttributes="Bold"
                   Margin="20,16,20,6" TextColor="{DynamicResource Primary}"/>

            <Border Margin="16,0" Padding="0"
                    BackgroundColor="{AppThemeBinding Light='White', Dark='#1E1E1E'}"
                    Stroke="{AppThemeBinding Light='#E0E0E0', Dark='#2A2A2A'}" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                    <Label Grid.Column="0" Text="Sign Out" FontSize="15"
                           TextColor="#FF4444" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="Log Out"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#FF4444"
                            FontSize="13" Padding="8,0"/>
                </Grid>
            </Border>

            <Label Text="pc-ify v1.0" FontSize="12" HorizontalOptions="Center"
                   Margin="0,24,0,16"
                   TextColor="{AppThemeBinding Light='#BBB', Dark='#555'}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
